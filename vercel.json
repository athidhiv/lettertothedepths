{
  "version": 2,
  "builds": [
    { "src": "api/app.py", "use": "@vercel/python" },
    { "src": "api/server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/predict", "destination": "api/index.py" },
    { "source": "/api/(.*)", "destination": "api/server.js" },
    { "source": "/style.css", "destination": "/style.css" },
    { "source": "/index.js", "destination": "/index.js" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}